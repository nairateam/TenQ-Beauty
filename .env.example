# --- Database ---
# Local MongoDB or a MongoDB Atlas connection string (include a database name, e.g. /tenq)
DATABASE_URL=mongodb://127.0.0.1:27017/tenq

# --- Payload ---
# Any long random string (e.g. `openssl rand -hex 32`)
PAYLOAD_SECRET=change-me
# The site's public address. On Vercel it defaults to the production domain if left unset.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Payments (Paystack) ---
# Secret key from Paystack dashboard > Settings > API Keys (sk_test_… while testing)
PAYSTACK_SECRET_KEY=

# --- Uploads (Cloudinary) ---
# From the Cloudinary dashboard. Leave empty to store uploads in /media (local development only).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Folder uploads are stored in
CLOUDINARY_FOLDER=tenq/media
